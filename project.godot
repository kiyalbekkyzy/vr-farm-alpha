; Engine configuration file for VR Farm Simulator.
; Adapted for farming project.

config_version=5

[application]

config/name="vr_farm_simulator"
run/main_scene="res://Scenes/MainFarmScene.tscn"  ; Главная сцена фермы
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://Assets/Icons/farm_icon.svg"

[autoload]

# Если будешь использовать XR в будущем, оставь эти строки
# XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
# XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"

[editor_plugins]

enabled=PackedStringArray()  ; Пока без XR, только стандартные плагины

[layer_names]

3d_physics/layer_1="Static World"           ; Земля, постройки
3d_physics/layer_2="Dynamic World"          ; Движущиеся объекты
3d_physics/layer_3="Pickable Objects"       ; Овощи, корзины, инструменты
3d_physics/layer_4="Wall Walking"           ; Не используется
3d_physics/layer_5="Grappling Target"       ; Не используется
3d_physics/layer_17="Held Objects"          ; Держимые предметы
3d_physics/layer_18="Player Hands"          ; Руки игрока
3d_physics/layer_19="Grab Handles"          ; Точки захвата
3d_physics/layer_20="Player Body"           ; Тело игрока
3d_physics/layer_21="Pointable Objects"     ; Объекты для наведения
3d_physics/layer_22="Hand Pose Areas"       ; Позиции рук
3d_physics/layer_23="UI Objects"            ; Меню, кнопки

[rendering]

textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=false
#openxr/default_action_map="res://XRController/openxr_action_map.tres"
shaders/enabled=true
